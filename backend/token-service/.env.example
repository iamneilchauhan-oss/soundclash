# Copy to .env (never commit the real one)
PORT=3000

# Apple MusicKit — from developer.apple.com (Certificates, Identifiers & Profiles > Keys)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# LiveKit — from livekit.io dashboard (or your self-hosted server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
